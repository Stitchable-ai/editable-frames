---
import { FAQ } from '../data/faq';
import { SITE } from '../data/site.mjs';
import { getStudyPosters } from '../data/posters';
import WhyEditableFrames from '../components/WhyEditableFrames.astro';
import AgentGuide from '../components/AgentGuide.astro';
import Page from '../layouts/Page.astro';import Playground from '../components/Playground';import studies from '../data/studies.json';
const description=SITE.description;
const posters=await getStudyPosters();
---
<Page title={SITE.title} description={description} schema={[{'@type':'FAQPage',mainEntity:FAQ.map(({q,a})=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]}>
<section class="hero"><div class="hero-kicker"><span class="live-dot"/> AN OPEN CANVAS FOR CODE-GENERATED VIDEO</div><div class="hero-line"><h1>Generate video with AI.<br/><em>Edit with simple clicks.</em></h1><div class="hero-control-note" data-edit-demo-origin>
  <span class="hero-edit-icon" data-edit-demo-icon aria-hidden="true"><svg width="32" height="38" viewBox="0 0 32 38" fill="none"><path d="M6 4V28L12 22L17 33L22 30L17 20H28L6 4Z" fill="currentColor" stroke="#fffefa" stroke-width="2.5" stroke-linejoin="round"/></svg></span>
  <span class="hero-note-intro">Watch a quick edit.<small>Then make it yours.</small></span>
  <span class="hero-note-finish">Your video.<br/><em>Your final say.</em></span>
  <span class="hero-note-check" aria-hidden="true">✓</span>
</div></div><div class="hero-bottom"><p>EditableFrames turns AI-written code into editable video clips.<br/>Fine-tune colors, cameras and timing—with controls and undo built in.</p></div></section>
<div class="studio-wrap"><Playground autoTour introDemo posters={posters} client:visible/></div>
<section class="possibilities"><span class="mono">NOT A FIXED VISUAL LANGUAGE</span><p>Product demos. Explainers. Promo clips.<br/><em>Create with AI. Fine-tune the details.</em></p><div class="capability-strip"><span>✳ Per-scene controls</span><span>↶ Reversible edits</span><span>◉ Canvas + Three.js studies</span><span>↗ Open to new libraries</span></div></section>
<section class="collection section" id="gallery"><div class="section-heading"><div><span class="eyebrow">THE COLLECTION / 01—12</span><h2>Editable video examples.<br/>Pick your starting point.</h2></div><p>Twelve editable studies. Five creative directions.<br/>Every one is a starting point, not a finished answer.</p></div><div class="genre-labels"><span>Product demos</span><span>3D worlds</span><span>Motion design</span><span>Explainers</span><span>Illustration</span></div><div class="gallery-grid">{studies.map((s,i)=><article class="study-card" data-gallery-card><div class="card-image"><a class="study-preview" href={`/genres/${s.scene}/`}><img src={posters[s.scene].src} srcset={posters[s.scene].srcSet} sizes="(max-width: 700px) 45vw, (max-width: 1280px) 29vw, 360px" alt={s.detail} width="1280" height="720" loading="lazy" decoding="async"/><span class="card-open" aria-hidden="true">↗</span></a><a class="card-create" href="#use-with-ai" data-study-brief={s.scene} aria-label={`Make this with AI: ${s.title}`}>Make this with AI <span aria-hidden="true">↓</span></a></div><a class="card-details" href={`/genres/${s.scene}/`}><div class="card-meta"><span class="mono">{String(i+1).padStart(2,'0')} / {s.genre}</span><span class="mono">{s.duration}s</span></div><h3>{s.title}</h3><p>{s.hook}</p></a></article>)}</div></section>
<AgentGuide/>
<section class="manifesto section"><span class="eyebrow">THE IDEA BEHIND EDITABLEFRAMES</span><div class="manifesto-grid"><h2>Make the video you want.<br/><em>Keep the details editable.</em></h2><div><p>EditableFrames, also written as Editable Frames, is an open-source framework for videos created with code and refined by people or AI agents. A clip can expose its own colors, shapes, camera, timing and media as controls, with reversible changes.</p><p>The controls are an interface to a scene, not a limit on what it can become. New renderers and libraries can join as the ideas get more interesting.</p><a class="text-link" href="/guide/">Meet the framework ↗</a></div></div><div class="principles"><article><span>01 / CREATE</span><h3>Start with an idea.</h3><p>Write a scene yourself or work with a tool-capable agent. Keep your choice of creative library.</p></article><article><span>02 / REFINE</span><h3>Expose the right details.</h3><p>One clip needs a headline. Another needs a camera. Give each one its own set of useful controls.</p></article><article><span>03 / KEEP GOING</span><h3>Change your mind.</h3><p>Refine a detail, undo it, try again. Here, save a still or edit settings; use the local SDK for supported video exports.</p></article></div></section>
<WhyEditableFrames/>
<section class="faq section" id="faq" aria-labelledby="faq-heading">
  <div><span class="eyebrow">Q&A / A FEW GOOD QUESTIONS</span><h2 id="faq-heading">Curious is a<br/>good place to start.</h2></div>
  <div>{FAQ.map(entry=><details id={entry.id}>
    <summary>{entry.q}</summary>
    {'comparison' in entry ? <div class="faq-comparison">
      <p>{entry.comparison.intro}</p>
      <table>
        <caption class="sr-only">Scene authoring and editing workflows compared</caption>
        <thead><tr><th scope="col">Framework</th><th scope="col">Scene code & editing</th></tr></thead>
        <tbody>{entry.comparison.frameworks.map(framework=><tr>
          <th scope="row"><a href={framework.href}>{framework.name} ↗</a></th>
          <td><p><strong>Scene code:</strong> {framework.scene}</p><p><strong>Editing:</strong> {framework.editing}</p></td>
        </tr>)}</tbody>
      </table>
      <p><strong>Why EditableFrames?</strong> {entry.comparison.takeaway}</p>
      <p class="faq-comparison-scope">{entry.comparison.scope} <a href="/guide/">Explore the beta scope ↗</a></p>
    </div> : <div><p data-faq-answer>{entry.a}</p>{'links' in entry && <p>{entry.links.map((link,i)=><>{i>0 && ' · '}<a href={link.href}>{link.label} ↗</a></>)}</p>}</div>}
  </details>)}</div>
</section>
<section class="closing section"><span class="eyebrow">YOUR NEXT FRAME IS WAITING</span><h2>A little less waiting.<br/><em>A little more making.</em></h2><a href="#playground" class="button primary">Go make something yours ↑</a><a href="https://stitchable.ai/" class="text-link" target="_blank" rel="noopener">Use it in Stitchable Pro ↗</a></section>
</Page>

<script>
 const cards=[...document.querySelectorAll<HTMLElement>('[data-gallery-card]')];
 const motion=window.matchMedia('(prefers-reduced-motion: reduce)');
 if(!motion.matches&&'IntersectionObserver' in window){
  const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){const card=entry.target as HTMLElement;card.dataset.reveal='visible';observer.unobserve(card)}})},{threshold:.1,rootMargin:'0px 0px -24px 0px'});
  cards.forEach((card,index)=>{card.style.setProperty('--reveal-delay',`${index%3*85}ms`);card.dataset.reveal='pending';observer.observe(card)});
  motion.addEventListener('change',()=>{if(motion.matches){observer.disconnect();cards.forEach(card=>{card.dataset.reveal='visible'})}},{once:true});
 }
</script>
