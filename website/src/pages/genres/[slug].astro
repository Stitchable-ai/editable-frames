---
import { getStudyPosters } from '../../data/posters';
import Page from '../../layouts/Page.astro';import Playground from '../../components/Playground';import studies from '../../data/studies.json';
export function getStaticPaths(){return studies.map(study=>({params:{slug:study.scene},props:{study}}))}
const {study}=Astro.props;
const posters=await getStudyPosters();
const fields=Object.values(study.schemas)[0];
const summaries:Record<string,string>={
 device:'Create a 3D phone product demo with EditableFrames. Swap iPhone and Pixel models, customize the app screen and brand, and adjust camera motion and lighting.',
 underwater:'Edit an underwater train animation with EditableFrames. Change water color, train speed, fish count and camera travel, then save a frame or edit recipe.',
 grain:'Edit a film-grain landscape animation with EditableFrames. Adjust sunset colors, film grain, landscape speed and framing, and save a still or edit recipe.',
 paper:'Create a paper stop-motion look with EditableFrames. Edit character and leaf colors, texture, acting and pose frame rate in a live code-generated video study.',
 storybook:'Edit a storybook collage animation with EditableFrames. Customize the night sky, window glow, stars and paper motion, with controls and undo in your browser.',
 ink:'Edit an ink drawing animation with EditableFrames. Change ink and paper colors, pen width, line movement and pacing, then save a frame or reusable edit settings.',
 showreel:'Customize kinetic typography with EditableFrames. Edit the final title, colors, motion energy and beat grid in a live animated promo study with undo and redo.',
 evolution:'Edit a product launch animation with EditableFrames. Change the fictional brand, accent color, lettering, reveal pace and network spread in a live video study.',
 castle:'Edit a procedural 3D castle animation: change tower height, roof colors, trees and camera orbit. Preview reversible changes in the EditableFrames playground.',
 dragon:'Explore a code-built skeletal dragon animation. Edit bone color, wings and jaw, then scrub the scene and undo changes in the EditableFrames playground.',
 unet:'Edit an illustrated U-Net explainer: change signal color, input noise and skip connections. A code-generated teaching schematic, not neural inference.',
 warehouse:'Edit an isometric logistics animation with conveyors, scanning and moving parcels. Change motion and camera framing in the EditableFrames playground.',
};
const titles:Record<string,string>={device:"3D Phone Product Demo",castle:"3D Castle Animation",dragon:"Skeletal Dragon Animation",underwater:"Underwater Train Animation",unet:"U-Net Scientific Explainer",grain:"Grain Film Animation",warehouse:"Isometric Logistics Animation",paper:"Paper Stop-Motion Animation",storybook:"Storybook Collage Animation",ink:"Ink Drawing Animation",showreel:"Kinetic Typography",evolution:"Product Evolution Animation"};
---
<Page title={`${titles[study.scene]} Playground — EditableFrames`} description={summaries[study.scene]??study.detail} path={`/genres/${study.scene}/`}>
<section class="hero genre-hero"><a class="back-link" href="/#gallery">← Back to the collection</a><p class="eyebrow">{study.genre} / EDITABLE CODE STUDY</p><h1>{titles[study.scene]}<br/><em>you can edit.</em></h1><p class="genre-intro">{study.hook} {study.detail}</p></section><div class="studio-wrap"><Playground initial={study.scene} posters={posters} client:visible/></div><section class="section genre-notes"><div><span class="eyebrow">MAKE IT YOURS</span><h2>What can you edit<br/>in this scene?</h2></div><div><p>This {study.duration}-second {titles[study.scene].toLowerCase()} study is rendered from code with Canvas or Three.js. The product demo also uses credited GLB device models. Its original title is <em>{study.title}</em>. Start the preview, try the controls, then scrub to compare the same moment before and after an edit.</p><ul>{Object.values(fields).map((f:any)=><li>{f.label}</li>)}</ul><p>Changes are reversible and saved in this browser. Download a still or an edit recipe; an edit recipe is a playground settings file, not a finished video.</p><a class="text-link" href="/guide/">Learn about code-generated video and the beta SDK ↗</a></div></section><section class="section related"><h2>Take a different direction.</h2><div class="gallery-grid">{studies.filter(s=>s.scene!==study.scene).slice(0,3).map(s=><a class="study-card" href={`/genres/${s.scene}/`}><img src={posters[s.scene].src} srcset={posters[s.scene].srcSet} sizes="(max-width: 700px) 45vw, (max-width: 1280px) 29vw, 360px" alt={s.title} width="1280" height="720" loading="lazy"/><span class="eyebrow">{s.genre}</span><h3>{s.title}</h3></a>)}</div></section>
</Page>
