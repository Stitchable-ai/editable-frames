---
import '../styles/site.css';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-mono/400.css';
const {title,description,path='/',image='/social.png',noindex=false,schema=[]}=Astro.props;
const origin='https://editableframes.stitchable.ai';const canonical=new URL(path,origin).href;
const framework={'@type':'SoftwareSourceCode','@id':origin+'/#framework',name:'EditableFrames',description:'MIT-licensed beta framework for code-generated video, optional clip-specific controls and reversible edits.',url:origin+'/',codeRepository:'https://github.com/Stitchable-ai/editable-frames',programmingLanguage:'JavaScript',license:'https://github.com/Stitchable-ai/editable-frames/blob/main/LICENSE',version:'0.1.0-beta.1',creator:{'@id':'https://stitchable.ai/#organization'}};
const breadcrumbs=path==='/'||noindex?[]:[{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'EditableFrames',item:origin+'/'},{'@type':'ListItem',position:2,name:title,item:canonical}]}];
const graph={'@context':'https://schema.org','@graph':[{'@type':'Organization','@id':'https://stitchable.ai/#organization',name:'Stitchable',url:'https://stitchable.ai/'},{'@type':'WebSite','@id':origin+'/#website',name:'EditableFrames',url:origin+'/',publisher:{'@id':'https://stitchable.ai/#organization'}},{'@type':'WebPage',name:title,description,url:canonical,'@id':canonical+'#page',isPartOf:{'@id':origin+'/#website'},about:{'@id':origin+'/#framework'},inLanguage:'en'},framework,...breadcrumbs,...schema]};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex?'noindex,follow':'index,follow'}/><meta name="theme-color" content="#f5f3ea"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:type" content="website"/><meta property="og:site_name" content="EditableFrames"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,origin).href}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="EditableFrames — code the motion, keep the control. Creative scenes with editable details."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(image,origin).href}/><script type="application/ld+json" is:inline set:html={JSON.stringify(graph).replace(/</g,'\\u003c')}/><slot name="head"/></head><body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><a class="wordmark" href="/" aria-label="EditableFrames home"><svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><path d="M3 12V3h9M20 3h9v9M29 20v9h-9M12 29H3v-9" fill="none" stroke="currentColor" stroke-width="3"/><path d="m12 9 11 7-11 7z" fill="currentColor"/></svg>Editable<span>Frames</span><sup>β</sup></a><nav aria-label="Main navigation"><a href="/#playground">Playground</a><a href="/#gallery">The collection</a><a href="/guide/">How it works</a><a href="https://github.com/Stitchable-ai/editable-frames" target="_blank" rel="noopener">GitHub ↗</a><a class="nav-cta" href="https://stitchable.ai/" target="_blank" rel="noopener">By Stitchable ↗</a></nav></header><main id="main"><slot/></main><footer class="site-footer"><a class="wordmark" href="/">EditableFrames<span class="footer-star">✳</span></a><p>A little code. A lot of possibility.</p><div><a href="/guide/">Guide & beta scope</a><a href="/reference/">Framework reference</a><a href="/credits/">Credits & licenses</a><a href="https://github.com/Stitchable-ai/editable-frames" target="_blank" rel="noopener">MIT source ↗</a><a href="https://stitchable.ai/" target="_blank" rel="noopener">Stitchable Pro Studio ↗</a></div><small>Built by parent company Stitchable · SDK beta 0.1.0 · Your playground edits stay in your browser.</small></footer></body></html>
