---
import '../styles/site.css';
import BrandMark from '../components/BrandMark.astro';
import BrandName from '../components/BrandName.astro';
import { SITE } from '../data/site.mjs';
import '@fontsource-variable/bricolage-grotesque';
import brandFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import '@fontsource/ibm-plex-mono/latin-400.css';
const {title,description,path='/',image='/social.png?v=simple-clicks-1',noindex=false,schema=[]}=Astro.props;
const origin=SITE.origin;const canonical=new URL(path,origin).href;
const framework={'@type':'SoftwareSourceCode','@id':origin+'/#framework',name:SITE.name,alternateName:SITE.alternateName,description:'MIT-licensed beta framework for code-generated video, optional clip-specific controls and reversible edits.',url:origin+'/',sameAs:SITE.repository,codeRepository:SITE.repository,programmingLanguage:'JavaScript',license:SITE.repository+'/blob/main/LICENSE',version:'0.1.0-beta.1',creator:{'@id':'https://stitchable.ai/#organization'}};
const breadcrumbs=path==='/'||noindex?[]:[{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'EditableFrames',item:origin+'/'},{'@type':'ListItem',position:2,name:title,item:canonical}]}];
const graph={'@context':'https://schema.org','@graph':[{'@type':'Organization','@id':'https://stitchable.ai/#organization',name:'Stitchable',url:'https://stitchable.ai/'},{'@type':'WebSite','@id':origin+'/#website',name:SITE.name,alternateName:SITE.alternateName,url:origin+'/',publisher:{'@id':'https://stitchable.ai/#organization'}},{'@type':'WebPage',name:title,description,url:canonical,'@id':canonical+'#page',isPartOf:{'@id':origin+'/#website'},about:{'@id':origin+'/#framework'},...(path==='/'?{mainEntity:{'@id':origin+'/#framework'}}:{}),inLanguage:'en'},framework,...breadcrumbs,...schema]};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><link rel="preload" href={brandFont} as="font" type="font/woff2" crossorigin/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex?'noindex,follow':'index,follow'}/><meta name="application-name" content={SITE.name}/><meta name="theme-color" content="#f5f3ea"/><link rel="icon" href="/favicon.svg?v=edit-1" type="image/svg+xml"/><meta property="og:type" content="website"/><meta property="og:site_name" content="EditableFrames"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,origin).href}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={`EditableFrames by Stitchable — ${SITE.slogan}`}/><meta name="twitter:image:alt" content={`EditableFrames by Stitchable — ${SITE.slogan}`}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(image,origin).href}/><script type="application/ld+json" is:inline set:html={JSON.stringify(graph).replace(/</g,'\\u003c')}/><slot name="head"/></head><body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><a class="wordmark" href="/" aria-label="EditableFrames by Stitchable home"><BrandMark/><BrandName/></a><nav aria-label="Main navigation"><a href="/#playground">Playground</a><a href="/#gallery">The collection</a><a href="/#use-with-ai">Use with AI</a><a href="/#faq">Q&A</a><a href="https://github.com/Stitchable-ai/editable-frames" target="_blank" rel="noopener" class="github-link"><img src="/tool-logos/github.svg" width="18" height="18" alt=""/>GitHub ↗</a><a class="nav-cta" href="https://stitchable.ai/" target="_blank" rel="noopener">Use it in Stitchable Pro ↗</a></nav></header><main id="main"><slot/></main><footer class="site-footer"><a class="wordmark" href="/"><BrandMark size={28}/><BrandName/></a><p>{SITE.slogan}</p><div><a href="/#use-with-ai">Use with AI</a><a href="/#faq">Q&A</a><a href="/guide/">Guide & beta scope</a><a href="/reference/">Framework reference</a><a href="/credits/">Credits & licenses</a><a href="/privacy/">Privacy & analytics</a><a href="https://github.com/Stitchable-ai/editable-frames" target="_blank" rel="noopener">MIT source ↗</a><a href="https://stitchable.ai/" target="_blank" rel="noopener">Stitchable Pro Studio ↗</a></div><small>Built by parent company Stitchable · SDK beta 0.1.0 · Your playground edits stay in your browser.</small></footer><script>import {initAnalytics} from '../lib/analytics';initAnalytics();</script></body></html>
