---
import { AGENT_GUIDES, DEFAULT_BRIEF, buildAgentPrompt, REPOSITORY } from '../data/agent-guides';
import StitchableStudio from './StitchableStudio';
import { STITCHABLE_PREVIEW } from '../data/stitchable-preview';
---
<section class="agent-guide section" id="use-with-ai" aria-labelledby="agent-guide-heading" data-agent-guide>
  <div class="section-heading">
    <div><span class="eyebrow">YOUR IDEA + YOUR AI TOOL</span><h2 id="agent-guide-heading">Bring your agent.<br/><em>Make your next video.</em></h2></div>
    <p>Start with your AI tool or Stitchable Pro.<br/>Make the video. Keep the details editable.</p>
  </div>
  <div class="agent-workbench">
    <div class="agent-tabs" role="tablist" aria-label="Choose your AI tool">
      {AGENT_GUIDES.map((guide,i)=><button type="button" role="tab" id={`agent-tab-${guide.id}`} aria-controls={`agent-panel-${guide.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-agent-tab={guide.id}><img src={`/tool-logos/${guide.logo}.svg`} width="27" height="27" alt=""/>{guide.name}</button>)}
      <button type="button" role="tab" id="agent-tab-stitchable" aria-controls="agent-panel-stitchable" aria-selected="false" tabindex="-1" data-agent-tab="stitchable"><img src="/tool-logos/stitchable.svg" width="27" height="27" alt=""/>Stitchable</button>
    </div>
    <div class="agent-brief"><label for="agent-creative-brief">01 / YOUR CREATIVE BRIEF</label><textarea id="agent-creative-brief" rows="3" maxlength="2500" placeholder={DEFAULT_BRIEF} data-agent-brief>{DEFAULT_BRIEF}</textarea><p>Make this yours. The prompt updates as you type.</p></div>
    {AGENT_GUIDES.map((guide,i)=><div class="agent-panel" id={`agent-panel-${guide.id}`} role="tabpanel" aria-labelledby={`agent-tab-${guide.id}`} hidden={i!==0} tabindex="0" data-agent-panel={guide.id}>
      <div class="agent-instructions"><span class="eyebrow">{guide.context}</span><h3>{guide.title}</h3><p>{guide.description}</p><ol>{guide.steps.map(step=><li>{step}</li>)}</ol><a class="agent-open" href={guide.url} target="_blank" rel="noopener">{guide.action} <span aria-hidden="true">↗</span></a><a class="text-link agent-docs" href={guide.docs} target="_blank" rel="noopener">Tool setup docs ↗</a></div>
      <div class="agent-prompt"><div class="agent-prompt-heading"><span class="mono">02 / COPY & PASTE</span><div class="agent-copy-buttons"><button type="button" data-agent-select aria-label={`Select ${guide.name} prompt text`}>Select text</button><button type="button" data-agent-copy="prompt" aria-label={`Copy ${guide.name} prompt`}>Copy prompt <span aria-hidden="true">⧉</span></button></div></div><label class="sr-only" for={`agent-prompt-${guide.id}`}>{guide.name} prompt</label><textarea id={`agent-prompt-${guide.id}`} readonly rows="14" spellcheck="false" data-agent-prompt>{buildAgentPrompt(guide.id)}</textarea><p class="agent-paste-note">Copy first, then paste into your tool. If your browser blocks clipboard sharing, use Select text and your keyboard’s Copy command. Opening the tool does not send your prompt.</p></div>
      <details class="agent-setup"><summary>Optional: set up the local SDK{guide.id==='chatgpt'?'':' and skill'}</summary><p>{guide.setupNote}</p><label class="sr-only" for={`agent-setup-${guide.id}`}>{guide.name} setup commands</label><textarea id={`agent-setup-${guide.id}`} readonly rows="4" spellcheck="false" data-agent-setup>{guide.setup}</textarea><button type="button" data-agent-copy="setup" aria-label={`Copy ${guide.name} setup commands`}>Copy setup commands ⧉</button></details>
    </div>)}
    <div class="agent-panel stitchable-panel" id="agent-panel-stitchable" role="tabpanel" aria-labelledby="agent-tab-stitchable" hidden tabindex="0" data-agent-panel="stitchable">
      <StitchableStudio client:visible/>
      <div class="agent-instructions stitchable-download"><div><span class="eyebrow">STITCHABLE PRO · DESKTOP APP</span><h3>Point to a detail. Make it yours.</h3><p>Fine-tune a scene with direct controls.<br/>Preview what’s next: point to an object, add a note, and turn it into an edit.</p></div><div class="stitchable-download-action"><a class="agent-open" href={STITCHABLE_PREVIEW.download} target="_blank" rel="noopener">Download Stitchable Pro <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 15v5h16v-5"/></svg></a><p class="stitchable-download-note">Guided demo · annotation is an upcoming feature.</p></div></div>
    </div>
    <p class="agent-copy-status" role="status" aria-live="polite" aria-atomic="true" data-agent-status>Your prompt stays here. You choose where to paste.</p>
    <noscript><p class="no-script">Read the <a href={`${REPOSITORY}/blob/main/docs/agents.md`}>agent setup guide</a> for all tools. You can select and copy the Claude prompt above.</p></noscript>
  </div>
  <div class="agent-source"><p>Open-source, model-neutral, and ready for new creative libraries.<br/>For local EditableFrames projects: Node.js, Chromium and FFmpeg.</p><a href={REPOSITORY} target="_blank" rel="noopener"><img src="/tool-logos/github.svg" width="23" height="23" alt=""/> Explore the MIT source <span aria-hidden="true">↗</span></a></div>
</section>
<script>
  import { capture } from '../lib/analytics';
  import { buildAgentPrompt } from '../data/agent-guides';
  import { buildStudyBrief } from '../data/study-briefs';
  for (const root of document.querySelectorAll<HTMLElement>('[data-agent-guide]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-agent-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-agent-panel]'));
    const brief = root.querySelector<HTMLTextAreaElement>('[data-agent-brief]')!;
    const status = root.querySelector<HTMLElement>('[data-agent-status]')!;
    const briefSection=brief.closest<HTMLElement>('.agent-brief')!;
    let lastPromptTab=0;
    function selectTab(index: number, focus = false) {
      const old=tabs.find(tab=>tab.getAttribute('aria-selected')==='true')?.dataset.agentTab;
      if(old!==tabs[index].dataset.agentTab)capture('site_tab_changed',{window_id:'agent_guide',from_tab_id:old,tab_id:tabs[index].dataset.agentTab});
      const isStitchable=tabs[index].dataset.agentTab==='stitchable';
      briefSection.hidden=isStitchable;
      if(!isStitchable)lastPromptTab=index;
      tabs.forEach((tab,i) => { tab.setAttribute('aria-selected',String(i===index)); tab.tabIndex=i===index?0:-1; });
      panels.forEach(panel => { panel.hidden=panel.dataset.agentPanel!==tabs[index].dataset.agentTab; });
      root.querySelectorAll<HTMLButtonElement>('[data-agent-copy]').forEach(button => { button.textContent=button.dataset.agentCopy==='prompt'?'Copy prompt ⧉':'Copy setup commands ⧉'; });
      status.textContent=isStitchable?'The Studio demo runs here. The download opens in a new tab.':'Your prompt stays here. You choose where to paste.';
      if(focus)tabs[index].focus();
    }
    tabs.forEach((tab,i) => {
      tab.addEventListener('click',() => selectTab(i));
      tab.addEventListener('keydown',event => {
        const next=event.key==='ArrowRight'?(i+1)%tabs.length:event.key==='ArrowLeft'?(i+tabs.length-1)%tabs.length:event.key==='Home'?0:event.key==='End'?tabs.length-1:null;
        if(next!==null){event.preventDefault();selectTab(next,true);}
      });
    });
    function updatePrompts() {
      panels.forEach(panel => { const prompt=panel.querySelector<HTMLTextAreaElement>('[data-agent-prompt]');if(prompt)prompt.value=buildAgentPrompt(panel.dataset.agentPanel!,brief.value); });
      root.querySelectorAll<HTMLButtonElement>('[data-agent-copy="prompt"]').forEach(button => { button.textContent='Copy prompt ⧉'; });
      status.textContent='Your creative brief is included in each tool’s prompt.';
    }
    brief.addEventListener('input',updatePrompts);
    document.querySelectorAll<HTMLAnchorElement>('[data-study-brief]').forEach(link=>link.addEventListener('click',event=>{
      // Keep modified clicks as normal links; never submit the brief to a tool.
      if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
      const selected=buildStudyBrief(link.dataset.studyBrief!);if(!selected)return;
      event.preventDefault();if(briefSection.hidden)selectTab(lastPromptTab);brief.value=selected;brief.placeholder=selected;updatePrompts();
      document.dispatchEvent(new Event('editableframes:brief-selected'));
      root.scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});
      brief.focus({preventScroll:true});
      status.textContent='This collection study is ready in every tool’s prompt. Refine the brief, then copy it to your agent.';
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-agent-select]').forEach(button => button.addEventListener('click',() => {
      const field=button.closest<HTMLElement>('[data-agent-panel]')!.querySelector<HTMLTextAreaElement>('[data-agent-prompt]')!;
      field.focus({preventScroll:true});field.select();
      status.textContent='Prompt selected. Press Command+C on Mac or Ctrl+C on Windows/Linux, then paste into your tool.';
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-agent-copy]').forEach(button => button.addEventListener('click',async () => {
      const panel=button.closest<HTMLElement>('[data-agent-panel]')!;
      const field=panel.querySelector<HTMLTextAreaElement>(button.dataset.agentCopy==='prompt'?'[data-agent-prompt]':'[data-agent-setup]')!;
      try {
        // Native selection copying reaches the OS pasteboard in embedded
        // WebViews whose Clipboard API may only update an internal clipboard.
        field.focus({preventScroll:true});field.select();
        let copied=false;
        try { copied=document.execCommand('copy'); } catch {}
        if(!copied)await navigator.clipboard.writeText(field.value);
        field.setSelectionRange(0,0);button.focus({preventScroll:true});
        capture('agent_setup_copied',{agent_id:panel.dataset.agentPanel,kind:button.dataset.agentCopy==='prompt'?'prompt':'commands',ict_stage:'transactional'});
        button.textContent='Copied ✓';
        status.textContent=button.dataset.agentCopy==='prompt'?'Prompt copied. Open your tool and paste it into a new conversation.':'Setup commands copied. Run them in a new local folder.';
      } catch {
        field.focus();field.select();
        status.textContent='Clipboard access is unavailable. The text is selected; use your browser’s Copy command.';
      }
    }));
  }
</script>
