{
  "name": "editableframes-website",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "astro dev --port 8794",
    "bundle": "node scripts/bundle.mjs",
    "check": "astro check",
    "build": "npm run bundle && astro build",
    "preview": "astro preview --port 8794",
    "deploy": "cf deploy --prebuilt",
    "ci": "npm run check && npm run build:cloudflare && cf deploy --prebuilt --dry-run",
    "build:cloudflare": "npm run build && wrangler build --experimental-new-config --experimental-cf-build-output"
  },
  "dependencies": {
    "@astrojs/react": "6.0.1",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "astro": "7.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "cf": "1.0.0-beta.13",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "wrangler": "4.148.0"
  }
}
